rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sesion() { return request.auth != null; }
    function miPerfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function activo() { return sesion() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && miPerfil().data.activo == true; }
    function rol() { return miPerfil().data.rol; }
    function principal() { return activo() && rol() == 'Administrador principal'; }
    // Corrigen y cierran registros, calendario y configuración de máquinas
    function gestor() { return activo() && rol() in ['Administrador principal', 'Supervisor de mantenimiento']; }
    function altas() { return activo() && rol() in ['Administrador principal', 'Administrador', 'Dirección', 'Gerencia']; }
    function mecanico() { return activo() && rol() == 'Mecánico'; }
    function maquinaValida(m) { return m in ['AMP-LA-001', 'AMP-LB-001']; }
    function rolAsignable(r) { return r in ['Administrador', 'Dirección', 'Gerencia', 'Coordinación', 'Supervisor de mantenimiento', 'Mecánico', 'Ingeniero de procesos', 'Operador']; }
    function cambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    function esCuentaInicial() { return request.auth.token.email == '1000@lajosefina-dpc.app'; }

    // Cuentas: Administración, Dirección y Gerencia dan de alta; solo el Administrador principal crea administradores y modifica cuentas
    match /usuarios/{uid} {
      allow read: if altas() || (sesion() && request.auth.uid == uid);
      // Configuración inicial (solo la cuenta 1000, una vez)
      allow create: if sesion() && request.auth.uid == uid && esCuentaInicial()
        && request.resource.data.rol in ['Dirección', 'Administrador principal']
        && request.resource.data.activo == true;
      // La cuenta 1000 pasa de Dirección a Administrador principal sin perder nada
      allow update: if sesion() && request.auth.uid == uid && esCuentaInicial()
        && resource.data.rol == 'Dirección'
        && request.resource.data.rol == 'Administrador principal'
        && cambia(['rol']);
      // El Administrador principal puede cambiar su propio nombre
      allow update: if principal() && request.auth.uid == uid && cambia(['nombre']);
      allow create: if principal() && rolAsignable(request.resource.data.rol);
      allow create: if altas() && rolAsignable(request.resource.data.rol)
        && request.resource.data.rol != 'Administrador';
      allow update: if principal() && request.auth.uid != uid
        && resource.data.rol != 'Administrador principal'
        && rolAsignable(request.resource.data.rol)
        && request.resource.data.usuario == resource.data.usuario;
      allow delete: if false;
    }

    // Trabajos y fallas
    match /registros/{id} {
      allow read: if activo();
      allow create: if activo()
        && maquinaValida(request.resource.data.equipo)
        && (principal() || (
              rol() in ['Mecánico', 'Ingeniero de procesos', 'Operador']
              && request.resource.data.tecnicoUid == request.auth.uid
              && request.resource.data.tecnico == miPerfil().data.nombre
              && request.resource.data.creadoEn == request.time
              && (rol() == 'Mecánico' || request.resource.data.tipo == 'Reporte de falla')
              && (request.resource.data.tipo != 'Reporte de falla' || request.resource.data.estado == 'Pendiente')));
      allow update: if gestor()
        || (mecanico() && resource.data.tipo == 'Reporte de falla'
            && resource.data.estado in ['Pendiente', 'Abierta']
            && request.resource.data.estado == 'En atención'
            && request.resource.data.atendidoUid == request.auth.uid
            && request.resource.data.atendidoPor == miPerfil().data.nombre
            && request.resource.data.inicioAtencion == request.time
            && cambia(['estado', 'atendidoUid', 'atendidoPor', 'inicioAtencion']))
        || (mecanico() && resource.data.tipo == 'Reporte de falla'
            && resource.data.estado == 'En atención'
            && resource.data.atendidoUid == request.auth.uid
            && request.resource.data.estado in ['Por confirmar', 'Cerrada']
            && request.resource.data.finAtencion == request.time
            && cambia(['estado', 'finAtencion', 'fechaCierre', 'trabajoRealizado', 'ajustes', 'refacciones', 'refaccionesUsadas', 'fotosCierre', 'minutos', 'causa']))
        // La operadora (o ingeniero de procesos) confirma: ✅ quedó bien / ❌ sigue fallando
        || (activo() && rol() in ['Operador', 'Ingeniero de procesos'] && resource.data.tipo == 'Reporte de falla'
            && resource.data.estado == 'Por confirmar'
            && ((request.resource.data.estado == 'Cerrada'
                 && request.resource.data.confirmadoUid == request.auth.uid
                 && request.resource.data.confirmadoEn == request.time
                 && cambia(['estado', 'fechaCierre', 'confirmadoPor', 'confirmadoUid', 'confirmadoEn', 'lineaReanudaEn']))
              || (request.resource.data.estado == 'Pendiente'
                 && request.resource.data.reabiertoEn == request.time
                 && cambia(['estado', 'reaperturas', 'intentos', 'atendidoUid', 'atendidoPor', 'inicioAtencion', 'finAtencion', 'trabajoRealizado', 'ajustes', 'reabiertoPor', 'reabiertoEn', 'avisos', 'escalado']))));
      allow delete: if gestor();
    }

    match /fotos/{id} {
      allow read: if activo();
      allow create: if activo()
        && request.resource.data.creadoUid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if gestor();
    }

    // Teléfonos registrados para recibir notificaciones push
    match /tokens/{t} {
      allow read, delete: if sesion() && resource.data.uid == request.auth.uid;
      allow create, update: if activo() && request.resource.data.uid == request.auth.uid && request.resource.data.token == t;
    }

    // Inventario de refacciones: Supervisor y Administrador principal lo administran; el mecánico solo descuenta lo que usa
    match /refacciones/{id} {
      allow read: if activo();
      allow create, delete: if gestor();
      allow update: if gestor()
        || (mecanico() && cambia(['existencia', 'actualizado'])
            && request.resource.data.existencia is number
            && request.resource.data.existencia < resource.data.existencia
            && request.resource.data.existencia >= 0);
    }
    match /movimientos/{id} {
      allow read: if activo();
      allow create: if (gestor() || mecanico()) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Ajustes de indicadores (semáforo): todos los leen, el administrador los cambia
    match /config/{id} {
      allow read: if activo();
      allow write: if gestor();
    }

    // Turnos con QR: la operadora inicia y finaliza el suyo; las correcciones dejan historial
    match /turnos/{id} {
      allow read: if activo() && (resource.data.operadorUid == request.auth.uid
        || rol() in ['Administrador principal', 'Supervisor de mantenimiento', 'Dirección', 'Gerencia', 'Coordinación']);
      allow create: if activo() && rol() in ['Operador', 'Administrador principal']
        && maquinaValida(request.resource.data.equipo)
        && request.resource.data.operadorUid == request.auth.uid
        && request.resource.data.operador == miPerfil().data.nombre
        && request.resource.data.inicio == request.time
        && request.resource.data.estado == 'Abierto'
        && request.resource.data.historial.size() == 0
        && !('fin' in request.resource.data);
      allow create: if gestor() && maquinaValida(request.resource.data.equipo)
        && request.resource.data.historial.size() == 1;
      allow update: if (activo() && resource.data.operadorUid == request.auth.uid
            && resource.data.estado == 'Abierto'
            && request.resource.data.estado == 'Cerrado'
            && request.resource.data.fin == request.time
            && cambia(['estado', 'fin', 'cierre']))
        || (gestor() && request.resource.data.equipo == resource.data.equipo
            && request.resource.data.operadorUid == resource.data.operadorUid
            && request.resource.data.historial.size() == resource.data.get('historial', []).size() + 1);
      allow delete: if false;
    }

    match /programa/{id} {
      allow read: if activo();
      allow write: if gestor();
    }

    match /maquinas/{id} {
      allow read: if activo();
      allow write: if gestor() && maquinaValida(id);
    }
  }
}
